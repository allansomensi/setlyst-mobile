{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities available to the main Setlyst window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://setlyst-api.onrender.com/*"
        }
      ]
    },
    "fs:default",
    "dialog:default"
  ]
}