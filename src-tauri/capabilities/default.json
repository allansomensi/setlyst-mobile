{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities available to the main Setlyst window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-set-fullscreen",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://setlyst-api.onrender.com/*"
        }
      ]
    },
    "fs:default",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**/*.json" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**/*.json" }]
    },
    { "identifier": "fs:allow-exists", "allow": [{ "path": "**/*.json" }] },
    "dialog:default"
  ]
}
